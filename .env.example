# Database
DATABASE_URL="YOUR_DATABASE_URL"

# Redis
REDIS_HOST=YOUR_REDIS_HOST
REDIS_PORT=YOUR_REDIS_PORT
REDIS_DB=YOUR_REDIS_DB

# Uploads (local PDF storage under apps/api)
UPLOAD_DIR=YOUR_UPLOAD_DIR

# LLM
OPENAI_BASE_URL=https://gateway.devscale.id/v1
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

TAVILY_API_KEY=YOUR_TAVILY_API_KEY

# Langfuse tracing
LANGFUSE_SECRET_KEY=YOUR_LANGFUSE_SECRET_KEY
LANGFUSE_PUBLIC_KEY=YOUR_LANGFUSE_PUBLIC_KEY
LANGFUSE_BASE_URL=YOUR_LANGFUSE_BASE_URL

# Application
NODE_ENV=production
HOST=0.0.0.0
PORT=8000

# Frontend build-time API URL. Leave empty when the frontend and API share a domain.
VITE_API_BASE_URL=

# Docker Compose defaults (override these in Dokploy)
POSTGRES_DB=itinerary
POSTGRES_USER=itinerary
POSTGRES_PASSWORD=change-this-password
